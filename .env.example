# Copy to .env.local and fill in. Everything is optional: the app runs fully without them
# (localStorage instead of Supabase, rule-based insights instead of Gemini).

# Supabase (client-exposed: project URL + publishable/anon key ONLY)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Google Gemini (server-only, never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
